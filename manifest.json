{
  "manifest_version": 3,
  "name": "HypeSquad Badge Web 2026",
  "version": "1.0",
  "description": "Set your Discord HypeSquad badge in 2026.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://discord.com/*"
  ]
}